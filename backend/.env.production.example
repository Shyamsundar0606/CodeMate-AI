# Example only. Replace every placeholder through your secret manager.
# Existing .env files are never overwritten. Invalid placeholders fail validation.
APP_ENV=production
COOKIE_SECURE=true
CORS_ORIGINS=["https://codemate.example"]
JWT_SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_OF_AT_LEAST_48_BYTES
DATABASE_URL=postgresql+psycopg://codemate_user:REPLACE_WITH_DATABASE_SECRET@127.0.0.1:5433/codemate_db
HTTP_MAX_BODY_BYTES=1048576
HTTP_BODY_TIMEOUT_SECONDS=15
# Optional integrations retain their existing configuration names.
# GitHub client ID/secret and an independent encryption key must be set together.
# Callback and frontend origin must use HTTPS and match the actual deployment.
# Ollama stays loopback-only; never expose port 11434 publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
