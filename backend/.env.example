APP_NAME=CodeMate AI
APP_ENV=development
# Local backend connects only to CodeMate on port 5433.
DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=codemate-ai
JWT_AUDIENCE=codemate-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:3000"]
# true is mandatory in production (HTTPS). false supports local HTTP only.
COOKIE_SECURE=false

# Register a GitHub App manually. Never put these values in NEXT_PUBLIC variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/github/callback
GITHUB_FRONTEND_ORIGIN=http://localhost:3000
GITHUB_APP_SLUG=
# Fixed approved destination; other URLs are rejected.
GITHUB_API_BASE_URL=https://api.github.com

# Local AI defaults; no inference credentials required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b
OLLAMA_TIMEOUT_SECONDS=120
AI_MAX_LOG_CHARS=64000
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_EVIDENCE_CHARS=12000
AI_MAX_CONCURRENT_INVESTIGATIONS=1
AI_MAX_RETRIES=2
AI_INVESTIGATION_RETENTION_DAYS=30

# Milestone 6: local voice. Paths are relative to the backend working directory.
VOICE_ENABLED=true
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_PATH=models/whisper-base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
VOICE_MAX_RECORDING_SECONDS=30
VOICE_MAX_UPLOAD_BYTES=8388608
VOICE_SESSION_TTL_SECONDS=1800
VOICE_ACTION_TTL_SECONDS=120
VOICE_TIMEOUT_SECONDS=60
VOICE_MAX_CONCURRENT_REQUESTS=1
VOICE_REQUESTS_PER_MINUTE=12
VOICE_RETAIN_TRANSCRIPTS=false
VOICE_TTS_ENABLED=true
PIPER_MODEL_PATH=models/en_US-ljspeech-medium.onnx
PIPER_CONFIG_PATH=models/en_US-ljspeech-medium.onnx.json
PIPER_SPEAKER_ID=0
